# 이 데모는 API 키가 필요 없습니다. 아래 값은 모두 선택이며, 적힌 값이 기본값입니다.
# 쓰려면 셸에서 export 하거나 실행 앞에 붙이세요. 예: RAG_MODE=mock uv run rag-rerank

# auto(기본): Ollama와 모델이 있으면 real, 없으면 mock / real: 실제 모델 강제 / mock: 가짜 모델 강제
RAG_MODE=auto

# 로컬 Ollama 주소와 모델 이름
OLLAMA_BASE_URL=http://localhost:11434
RAG_EMBED_MODEL=bge-m3
RAG_CHAT_MODEL=qwen3:4b

# 리랭커 모델(onnx-community/bge-reranker-v2-m3-ONNX)의 고정 리비전(커밋 해시)
RAG_RERANKER_REVISION=6f5ff65298512715a1e669753bc754d2bc8f367b

# 모델·색인 캐시 폴더(프로젝트 안, git에 올라가지 않음)
RAG_CACHE_DIR=.cache

# 웹 서버 포트(주소는 항상 127.0.0.1)
RAG_PORT=8765

# 리랭커 점수가 이 값보다 낮으면 "근거 부족"으로 봅니다(실제 모드 전용)
RAG_MIN_RERANK_SCORE=0.01
